    "editorToolbar": {
      "primary": {
        "background": "#1C1C1C",
        "icon": "#A6ADA6",
        "hover": "#2A2A2A"
      },
      "secondary": {
        "background": "#222222"
      }
    },
    "editorSidebar": {
      "primary": {
        "background": "#1C1C1C"
      }
    },
    "dialog": {
      "primary": {
        "background": "#222222",
        "border": "#3A3B3A",
        "hover": "#2A2A2A"
      }
    },
    "contextMenu": {
      "primary": {
        "background": "#222222",
        "border": "#3A3B3A",
        "hover": "#2A2A2A"
      }
    },
    "sheet": {
      "primary": {
        "background": "#222222",
        "border": "#3A3B3A"
      }
    }
  }
}
