      "primary": {
        "background": "#171717",
        "paragraph": "#CCD0CF",
        "heading": "#F25623",
        "border": "#2A2A2A"
      },
      "secondary": {
        "background": "#222222",
        "paragraph": "#AEAB94",
        "border": "#3A3B3A"
