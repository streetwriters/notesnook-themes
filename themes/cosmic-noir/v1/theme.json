    "titleBar": {
      "primary": {
        "background": "#171717",
        "paragraph": "#959C95",
        "icon": "#959C95"
      }
    },
    "statusBar": {
      "primary": {
        "background": "#171717",
        "paragraph": "#959C95",
        "icon": "#959C95",
        "separator": "#171717"
      }
    },
    "navigationMenu": {
      "primary": {
        "background": "#0F0F0F",
        "paragraph": "#A6ADA6",
        "icon": "#A6ADA6",
        "hover": "#222222"
      },
      "selected": {
        "background": "#222222",
        "paragraph": "#CCD0CF",
        "icon": "#F25623"
      }
    },
    "list": {
      "primary": {
        "background": "#1C1C1C",
        "paragraph": "#A6ADA6",
        "heading": "#CCD0CF",
        "hover": "#2A2A2A"
      },
      "secondary": {
        "paragraph": "#959C95",
        "icon": "#959C95"
      },
      "selected": {
        "background": "#2A2A2A",
        "heading": "#F25623"
