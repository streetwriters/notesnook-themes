{
  "$schema": "https://raw.githubusercontent.com/streetwriters/notesnook-themes/main/schemas/v1.schema.json",
  "name": "Cosmic Sumi",
  "id": "cosmic-sumi",
  "version": 1,
  "license": "MIT",
  "homepage": "https://github.com/atraxsrc/cosmic-sumi-theme",
  "description": "Jet, paper and moss, from the Sumi COSMIC rice",
  "colorScheme": "dark",
  "compatibilityVersion": 1,
  "tags": [
