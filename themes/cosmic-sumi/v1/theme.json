        "background": "#111111",
        "border": "#2A2A2A",
        "hover": "#1E1E1E"
      }
    },
    "contextMenu": {
      "primary": {
        "background": "#111111",
        "border": "#2A2A2A",
        "hover": "#1E1E1E"
      }
    },
    "sheet": {
      "primary": {
        "background": "#111111",
        "border": "#2A2A2A"
      }
    }
