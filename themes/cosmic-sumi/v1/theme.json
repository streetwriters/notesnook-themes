        "icon": "#5F5D58",
        "separator": "#1E1E1E",
        "placeholder": "#5F5D58",
        "hover": "#111111",
        "backdrop": "#030303B3"
      },
      "selected": {
        "accent": "#8B9388",
        "accentForeground": "#050505",
        "paragraph": "#D6D0C5",
        "background": "#1E1E1E",
        "border": "#8B9388",
        "heading": "#D6D0C5",
        "icon": "#8B9388",
        "separator": "#2A2A2A",
