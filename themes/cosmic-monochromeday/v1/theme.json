        "background": "#ECECEC"
      }
    },
    "dialog": {
      "primary": {
        "background": "#F1F1F1",
        "border": "#C0C0C0",
        "hover": "#DBDBDB"
      }
    },
    "contextMenu": {
      "primary": {
        "background": "#F1F1F1",
        "border": "#C0C0C0",
        "hover": "#DBDBDB"
      }
