{
  "$schema": "https://raw.githubusercontent.com/streetwriters/notesnook-themes/main/schemas/v1.schema.json",
  "name": "Cosmic Monochrome Day",
  "id": "cosmic-monochromeday",
  "version": 1,
  "license": "MIT",
  "homepage": "https://github.com/atraxsrc/cosmic-monochromeday-theme",
  "description": "Grays only, from the Monochrome Day COSMIC rice",
