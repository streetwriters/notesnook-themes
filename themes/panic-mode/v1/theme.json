      "secondary": {
        "background": "#0e141e"
      },
      "selected": {
        "background": "#232f45",
        "icon": "#f6a82a"
      }
    },
    "editorToolbar": {
      "primary": {
        "paragraph": "#e0e2d5",
        "background": "#0e141e",
        "border": "#1b2436"
      }
    },
    "dialog": {
      "primary": {
        "accent": "#f6a82a",
        "background": "#0e141e"
      },
      "secondary": {
        "background": "#151e2d"
      }
    },
    "navigationMenu": {
      "primary": {
        "background": "#0e141e"
      },
      "selected": {
        "background": "#232f45",
        "icon": "#f6a82a"
      }
    },
    "contextMenu": {
      "primary": {
        "background": "#0e141e"
      }
    },
    "sheet": {
      "primary": {
        "background": "#0e141e"
      },
      "selected": {
        "paragraph": "#f6a82a"
      }
    }
  }
